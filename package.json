{
  "name": "@morseai/sdk",
  "version": "0.1.0-beta.5",
  "description": "MORSE SDK - TypeScript SDK for creating and accessing encrypted signals",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "docs"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "deploy": "powershell -ExecutionPolicy Bypass -File ./publish.ps1"
  },
  "keywords": [
    "morse",
    "encryption",
    "signals",
    "privacy",
    "crypto",
    "end-to-end-encryption",
    "wallet",
    "ethereum",
    "zero-knowledge",
    "ephemeral",
    "secure-messaging",
    "x25519",
    "xchacha20-poly1305"
  ],
  "author": "MORSE Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/morseaitech/sdk.git"
  },
  "homepage": "https://morseai.tech",
  "bugs": {
    "url": "https://github.com/morseaitech/sdk/issues"
  },
  "dependencies": {
    "ethers": "^6.0.0",
    "libsodium-wrappers": "^0.7.16"
  },
  "devDependencies": {
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "ethers": "^6.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}